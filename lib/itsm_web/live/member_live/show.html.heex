<.header>
  Member {@member.id}
  <:subtitle>This is a member record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/admin/members/#{@member}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit member</.button>
    </.link>
  </:actions>
</.header>

<%!-- <.list></.list> --%>

<.back navigate={~p"/admin/members"}>Back to members</.back>

<.modal
  :if={@live_action == :edit}
  id="member-modal"
  show
  on_cancel={JS.patch(~p"/admin/members/#{@member}")}
>
  <.live_component
    module={ItsmWeb.MemberLive.FormComponent}
    id={@member.id}
    title={@page_title}
    action={@live_action}
    member={@member}
    patch={~p"/admin/members/#{@member}"}
  />
</.modal>
