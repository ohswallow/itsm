<Layouts.default current_path={@current_path} current_params={@current_params} flash={@flash}>
  <.header>
    {gettext("Listing Delegations")}
    <:actions>
      <.link patch={~p"/delegations/new"}>
        <.button>{gettext("New Delegation")}</.button>
      </.link>
    </:actions>
  </.header>
  
  <.table
    id="delegations"
    rows={@streams.delegations}
    row_click={fn {_id, delegation} -> JS.navigate(~p"/delegations/#{delegation}") end}
  >
    <:col :let={{_id, delegation}} label={gettext("Delegator Name")}>
      {delegation.delegator_name}
    </:col>
    
    <:col :let={{_id, delegation}} label={gettext("Delegatee Name")}>
      {delegation.delegatee_name}
    </:col>
    
    <:col :let={{id, delegation}} label={gettext("Start Date")}>
      <div
        id={"delegation-start-date-#{id}"}
        phx-hook="LocalTime.ToLocale"
        format="date"
        utc-value={delegation.start_date}
      />
    </:col>
    
    <:col :let={{id, delegation}} label={gettext("End Date")}>
      <div
        id={"delegation-end-date-#{id}"}
        phx-hook="LocalTime.ToLocale"
        format="date"
        utc-value={delegation.end_date}
      />
    </:col>
    
    <:col :let={{_id, delegation}} label={gettext("Reason")}>{delegation.reason}</:col>
    
    <:col :let={{_id, delegation}} label={gettext("Created By")}>
      {delegation.created_by_name}
    </:col>
    
    <:action :let={{_id, delegation}}>
      <%= if can_delete?(@current_scope.user, delegation) do %>
        <.link
          id={delegation.id}
          phx-click={JS.push("delete", value: %{id: delegation.id})}
          class="phx-click-loading:opacity-50 phx-click-loading:cursor-wait"
          data-confirm={gettext("Do you want to delete this item?")}
        >
          {gettext("Delete")}
        </.link>
      <% end %>
    </:action>
  </.table>
  
  <.modal
    :if={@live_action in [:new]}
    id="delegation-modal"
    show
    on_cancel={JS.patch(~p"/delegations")}
  >
    <.live_component
      module={ItsmWeb.DelegationLive.FormComponent}
      id={@delegation.id || :new}
      title={@page_title}
      action={@live_action}
      delegation={@delegation}
      current_scope={@current_scope}
      patch={~p"/delegations"}
    />
  </.modal>
</Layouts.default>
