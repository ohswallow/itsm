<Layouts.admin current_scope={@current_scope} menu_title={gettext("Crews")} flash={@flash}>
  <.header>
    Listing Crews

    <:actions>
      <.link navigate={~p"/admin/crews/new"}>
        <.button>New Crew</.button>
      </.link>
    </:actions>
  </.header>

  <.itsm_table_container results={assigns[:results]}>
    <.table
      id="crews"
      rows={@streams.crews}
      row_click={fn {_id, crew} -> JS.navigate(~p"/admin/crews/#{crew}") end}
    >
      <:col :let={{_id, crew}} label={gettext("Name")}>{crew.name}</:col>

      <:col :let={{_id, crew}} label={gettext("Description")}>{crew.description}</:col>

      <:action :let={{_id, crew}}>
        <div class="sr-only"><.link navigate={~p"/admin/crews/#{crew}"}>Show</.link></div>
         <.link navigate={~p"/admin/crews/#{crew}/edit"}>Edit</.link>
      </:action>

      <:action :let={{_id, crew}}>
        <.link
          id={crew.id}
          phx-click={JS.push("delete", value: %{id: crew.id})}
          class="phx-click-loading:opacity-50 phx-click-loading:cursor-wait"
          data-confirm="Are you sure?"
        >
          Delete
        </.link>
      </:action>
    </.table>
  </.itsm_table_container>
</Layouts.admin>
