<.header>
  Common Code {@common_code.id}
  <:subtitle>This is a common code record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/admin/common_codes/#{@common_code}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit common code</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title={gettext("Group Code")}>{@common_code.group_code}</:item>
  <:item title={gettext("Code")}>{@common_code.code}</:item>
  <:item title={gettext("Label")}>{@common_code.label}</:item>
  <:item title={gettext("Description")}>{@common_code.description}</:item>
  <:item title={gettext("Sort Order")}>{@common_code.sort_order}</:item>
  <:item title={gettext("Is Active")}>{@common_code.is_active}</:item>
  <:item title={gettext("Inserted At")}>
    <span
      id={"common-code-inserted-at-#{@common_code.id}"}
      phx-hook="LocalTime.ToLocale"
      utc-value={@common_code.inserted_at}
    />
  </:item>
  <:item title={gettext("Updated At")}>
    <span
      id={"common-code-updated-at-#{@common_code.id}"}
      phx-hook="LocalTime.ToLocale"
      utc-value={@common_code.updated_at}
    />
  </:item>
</.list>

<.back navigate={~p"/admin/common_codes"}>Back to common_codes</.back>

<.modal
  :if={@live_action == :edit}
  id="common_code-modal"
  show
  on_cancel={JS.patch(~p"/admin/common_codes/#{@common_code}")}
>
  <.live_component
    module={ItsmWeb.Admin.CommonCodeLive.FormComponent}
    id={@common_code.id}
    title={@page_title}
    action={@live_action}
    common_code={@common_code}
    current_scope={@current_scope}
    patch={~p"/admin/common_codes/#{@common_code}"}
  />
</.modal>
