<Layouts.admin current_scope={@current_scope} menu_title={gettext("Comments")} flash={@flash}>
  <div class="max-w-5xl">
    <.header>
      {@page_title}
      <:subtitle>Use this form to manage comment records in your database.</:subtitle>

      <:actions>
        <.button navigate={~p"/admin/comments"}>
          <.icon name="hero-arrow-left" />
        </.button>
      </:actions>
    </.header>

    <.card
      visible={@conflict}
      state={:error}
      title="⚠️ 충돌 발생!"
    >
      <p>{@conflict_msg}</p>
      <p>현재 편집 내용을 저장할 수 없습니다. 새로고침 후 다시 시도해 주세요.</p>
      <p><.link class="btn" navigate={@current_path}>새로고침</.link></p>
    </.card>

    <.form
      for={@form}
      id="comment-form"
      phx-change="validate"
      phx-submit="save"
    >
      <.input field={@form[:resource_type]} type="text" label="Resource Type" />
      <.input field={@form[:resource_id]} type="text" label="Resource ID" />
      <.input field={@form[:comment]} type="text" label="Comment" />
      <.itsm_calendar
        :if={@live_action == :edit}
        field={@form[:inserted_at]}
        label={gettext("Inserted At")}
        show_time
        default_selected_date_time={@form[:inserted_at].value}
      />
      <.button :if={!@conflict} phx-disable-with="Saving...">Save Comment</.button>
    </.form>
  </div>
</Layouts.admin>
