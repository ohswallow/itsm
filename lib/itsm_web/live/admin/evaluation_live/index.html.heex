<Layouts.admin current_scope={@current_scope} menu_title={gettext("Evaluations")} flash={@flash}>
  <.header>
    Listing Evaluations
  </.header>

  <.itsm_table_container results={assigns[:results]}>
    <.table
      id="evaluations"
      rows={@streams.evaluations}
      row_click={fn {_id, evaluation} -> JS.navigate(~p"/admin/evaluations/#{evaluation}") end}
    >
      <:col :let={{_id, evaluation}} label={gettext("Crew")}>{evaluation.crew.name}</:col>
      <:col :let={{_id, evaluation}} label={gettext("Comment")}>{evaluation.comment}</:col>
      <:col :let={{_id, evaluation}} label={gettext("Rating")}>{evaluation.rating}</:col>
      
      <:action :let={{_id, evaluation}}>
        <div class="sr-only">
          <.link navigate={~p"/admin/evaluations/#{evaluation}"}>Show</.link>
        </div>
        <.link navigate={~p"/admin/evaluations/#{evaluation}/edit"}>Edit</.link>
      </:action>
      <:action :let={{_id, evaluation}}>
        <.link
          id={evaluation.id}
          phx-click={JS.push("delete", value: %{id: evaluation.id})}
          class="phx-click-loading:opacity-50 phx-click-loading:cursor-wait"
          data-confirm="Are you sure?"
        >
          Delete
        </.link>
      </:action>
    </.table>
  </.itsm_table_container>
  
  <.table
      id="crew_ratings"
      rows={@streams.crew_ratings}
    >
    <:col :let={{_id, crew_ratings}} label={gettext("Crew")}>{crew_ratings.crew_name}</:col>
    <:col :let={{_id, crew_ratings}} label={gettext("AVG Rating")}>{crew_ratings.avg_rating}</:col>
  </.table>
</Layouts.admin>
