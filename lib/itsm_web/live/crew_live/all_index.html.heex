<Layouts.default current_scope={@current_scope} menu_title={gettext("All Crews")} flash={@flash}>
  <.header>{@page_title}</.header>

  <.itsm_table_container results={assigns[:results]}>
    <.crew_table
      crews={@streams.crews}
      row_click={
        fn {_id, crew} ->
          return_url = ~p"/crews/all?#{assigns[:results][:params] || %{}}"
          JS.navigate(~p"/crews/#{crew}?return_to=#{return_url}")
        end
      }
    >
    </.crew_table>
  </.itsm_table_container>
</Layouts.default>
