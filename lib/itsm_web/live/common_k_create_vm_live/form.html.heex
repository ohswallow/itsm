<Layouts.default current_scope={@current_scope} menu_title={gettext("Service Request")} flash={@flash}>
  <.header>{@page_title}</.header>

  <.card
    visible={@conflict}
    state={:error}
    title="⚠️ 충돌 발생!"
  >
    <p>{@conflict_msg}</p>
    <p>현재 편집 내용을 저장할 수 없습니다. 새로고침 후 다시 시도해 주세요.</p>
    <p>
      <.link class="btn" navigate={@current_path}>새로고침</.link>
    </p>
  </.card>

  <.form for={@form} id="request-form" phx-change="validate" phx-submit="save" >
    <.input field={@form[:requestor_crew_id]} type="select" label={gettext("My Crew")} prompt="Choose a crew" options={@crew_options} phx-debounce="blur" />
    <.input field={@form[:title]} type="text" label={gettext("Title")} phx-debounce="blur" />
    <.input field={@form[:description]} type="textarea" label={gettext("Description")} rows="10" phx-debounce="blur" />
    <.input field={@form[:env]} type="select" label={gettext("Environment")} prompt="Choose an environment" options={@env_options} phx-debounce="blur" />
    <.itsm_calendar field={@form[:due_date]} label={gettext("Due Date")} min={DateTime.utc_now()} show_time default_selected_date_time={@form[:due_date].value} />

    <h2 class="text-lg font-semibold text-base-content mt-6">{gettext("VM Creation Request")}</h2>
    <.button class="btn btn-circle tooltip tooltip-open tooltip-right tooltip-start mt-4" data-tip={gettext("Add VM")} name="request[common_k_create_vms_sort][]" phx-click={JS.dispatch("change")} value="new" >
      <.icon name="hero-plus-circle" class="h-5 w-5"/>
    </.button>
    <div class="mt-4">
      <.inputs_for :let={common_k_create_vm_f} field={@form[:common_k_create_vms]}>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
          <input type="hidden" name="request[common_k_create_vms_sort][]" value={common_k_create_vm_f.index} />
          <.input field={common_k_create_vm_f[:hostname]} label={gettext("Hostname")} type="text" />
          <.input field={common_k_create_vm_f[:service_name]} label={gettext("Service Name")} type="text" />
          <.input field={common_k_create_vm_f[:os_image]} label="OS 종류" type="select" prompt="Choose a value" options={@group_code_options} />
          <.input field={common_k_create_vm_f[:os_version]} type="select" label="OS 버전" prompt="Choose a value" options={if common_k_create_vm_f[:os_image].value in [nil, ""], do: [], else: Map.get(@os_version_options, common_k_create_vm_f[:os_image].value) } />
          <.input field={common_k_create_vm_f[:cpu]} label="CPU (vCore)" type="number" />
          <.input field={common_k_create_vm_f[:memory]} label="Memory (GB)" type="number" />
          <.input field={common_k_create_vm_f[:location]} type="select" label={gettext("Location")} prompt="Choose a value" options={@location_options} />
          <.input field={common_k_create_vm_f[:is_dmz_zone]} label={gettext("Is DMZ?")} type="checkbox" />
        </div>
        <.button class="btn btn-circle tooltip tooltip-start md:tooltip-right md:tooltip-center mt-4" data-tip={gettext("Remove VM")} name="request[common_k_create_vms_drop][]" value={common_k_create_vm_f.index} phx-click={JS.dispatch("change")}  >
          <.icon name="hero-x-mark" class="w-5 h-5" />
        </.button>
      </.inputs_for>
    </div>
    <input type="hidden" name="request[common_k_create_vms_drop][]" />

    <ImageViewerComponent.viewer :if={@live_action == :edit and @attachments_count > 0} id="request_image" images={@streams.attachments} image_count={@attachments_count} />

    <div class="mt-4">
      <label class="label p-0 mb-2">
        <span class="label-text text-sm font-semibold text-base-content">{gettext("Attachments")}</span>
      </label>

      <UploadComponents.dropzone upload={@uploads.attachment} />

      <!-- Crews 선택 영역 -->
      <div class="mt-6">
        <.live_select label={gettext("Crews to reference")} field={@form[:referenced_crews]} mode={:tags} value_mapper={&referenced_crews_value_mapper/1} placeholder={gettext("Search by crew or member name")} />
      </div>

      <!-- Base 에러 처리 (Alert 컴포넌트 구조화) -->
      <div :if={@form.errors[:base]} class="alert alert-error mt-6 shadow-sm">
        <.icon name="hero-x-circle" class="size-5 shrink-0" />
        <span>{translate_errors(@form.errors, :base)}</span>
      </div>

      <!-- 푸터 버튼 영역 -->
      <footer class="mt-6 flex items-center gap-2">
        <.button :if={!@conflict} class="btn btn-primary" phx-disable-with="Saving...">{gettext("Save Request")}</.button>
        <.button class="btn" navigate={if @live_action == :new, do: ~p"/categories", else: ~p"/requests"}>{gettext("Cancel")}</.button>
      </footer>
    </div>
  </.form>

</Layouts.default>
