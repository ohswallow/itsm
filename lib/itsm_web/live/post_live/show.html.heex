<Layouts.default current_scope={@current_scope} menu_title={gettext("Boards")} flash={@flash}>
  <.header>
    {assigns[:board_name] || "Not Found"} Post {@post.id}
    <:subtitle>This is a post record from your database.</:subtitle>

    <:actions>
      <.button navigate={~p"/posts?board_id=#{assigns[:board_id]}"}>
        <.icon name="hero-arrow-left" />
      </.button>
      <.button :if={@post.author.id == @current_scope.user_id} navigate={~p"/posts/#{@post}/edit?board_id=#{assigns[:board_id]}"} class="btn">Edit</.button>
    </:actions>
  </.header>

  <.list>
    <:item title={gettext("Board")}>{@post.board.name}</:item>
    <:item title={gettext("Title")}>{@post.title}</:item>
    <:item title={gettext("Content")}>{@post.content}</:item>
    <:item
      :for={
        %{"label" => label, "name" => name, "type" => type} = field <-
          @post.board.metadata["fields"]
      }
      :if={Map.get(field, "is_hidden") != true}
      title={label}
    >
      <span
        :if={type == "date"}
        id={"#{name}-#{@post.id}"}
        phx-hook="LocalTime.ToLocale"
        utc-value={@post.metadata[name]}
      />
      <span :if={type != "date"}>
        {@post.metadata[name]}
      </span>
    </:item>
    <:item title={gettext("Author")}>{@post.author.display_name}</:item>
    <:item title={gettext("Inserted At")}>
      <span
        id={"post-inserted-at-#{@post.id}"}
        phx-hook="LocalTime.ToLocale"
        utc-value={@post.inserted_at}
      />
    </:item>
    <:item title={gettext("Updated At")}>
      <span
        id={"post-updated-at-#{@post.id}"}
        phx-hook="LocalTime.ToLocale"
        utc-value={@post.updated_at}
      />
    </:item>
  </.list>

  <.attachments_section
    :if={@attachments_count > 0}
    id="attachments"
    attachments_count={@attachments_count}
  >
    <.attachment
      :for={{dom_id, attachment} <- @streams.attachments}
      id={dom_id}
      attachment={attachment}
    />
  </.attachments_section>

  <div :if={@post.metadata["allow_comment"] in ["true", true]}>
    <.comments_section streams={@streams} />
    <.comment_form
      form={@form}
      uploads={@uploads}
    />
  </div>

  <.attachment_modal
    :if={@selected_attachment}
    attachment={@selected_attachment}
  />
</Layouts.default>
