<Layouts.default current_scope={@current_scope} menu_title={gettext("My Request List")} flash={@flash}>
  <.header>{gettext("Listing Requests")}</.header>

  <.itsm_table_container results={assigns[:results]}>
    <.table
      id="requests"
      rows={@streams.requests}
      row_click={
        fn {_id, request} -> JS.navigate("/#{request.category.request_name}/#{request.id}") end
      }
    >
      <:col :let={{id, request}} label={gettext("ID")}>
        <.copyable_text label={gettext("ID")} id={id} value={request.id} />
      </:col>

      <:col :let={{_id, request}} label={gettext("Request Name")}>{request.category.name}</:col>

      <:col :let={{id, request}} label={gettext("Reqeust Date")}>
        <div id={"due-date-#{id}"} phx-hook="LocalTime.ToLocale" utc-value={request.inserted_at} />
      </:col>

      <:col :let={{id, request}} label={gettext("Due Date")}>
        <div id={"due-date-#{id}"} phx-hook="LocalTime.ToLocale" utc-value={request.due_date} />
      </:col>

      <:col :let={{_id, request}} label={gettext("Status")}>{request.status}</:col>

      <:col :let={{_id, request}} label={gettext("Title")}>{request.title}</:col>

      <:col :let={{_id, request}} label={gettext("Env")}>
        <.common_code_label group="운영_구분" code={request.env} />
      </:col>

      <:col :let={{_id, request}} label={gettext("Requestor Name")}>
        {request.requestor.display_name}
      </:col>

      <:col :let={{_id, request}} label={gettext("Action Crew")}>
        {request.assignee_crew.name}
      </:col>

      <:action :let={{_id, request}} >

        <div :if={request.requestor_id == @current_scope.user.id and request.status == :validation} class="dropdown dropdown-top dropdown-end" >
          <div tabindex="0" role="button" class="btn m-1" >
          <.icon name="hero-ellipsis-vertical" class="h-6 w-6"/>
          ️</div>
          <ul tabindex="-1" class="dropdown-content menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm">
            <li>
              <.link patch={"/#{request.category.request_name}/#{request.id}/edit"}>
                <.icon name="hero-pencil" class="w-4 h-4" /> {gettext("Edit")}
              </.link>
            </li>
            <li>
              <.link phx-click={JS.push("delete", value: %{id: request.id})} data-confirm="Are you sure?" >
                <.icon name="hero-trash" class="w-4 h-4" /> {gettext("Delete")}
              </.link>
            </li>
          </ul>
        </div>
      </:action>
    </.table>
  </.itsm_table_container>
</Layouts.default>
