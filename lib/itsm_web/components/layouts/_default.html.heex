<div class="drawer lg:drawer-open">
  <input id="my-drawer-4" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content">
    <!-- Navbar -->
    <nav class="navbar w-full bg-base-300">
      <label for="my-drawer-4" aria-label="open sidebar" class="btn btn-square btn-ghost">
        <!-- Sidebar toggle icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          stroke-linejoin="round"
          stroke-linecap="round"
          stroke-width="2"
          fill="none"
          stroke="currentColor"
          class="my-1.5 inline-block size-4"
        ><path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z">
        </path><path d="M9 4v16"></path><path d="M14 10l2 2l-2 2"></path></svg>
      </label>
      
      <div class="px-4">Navbar Title</div>
    </nav>
    <!-- Page content here -->
    <div class="p-4">{render_slot(@inner_block)}</div>
  </div>
  
  <div class="drawer-side is-drawer-open:overflow-visible">
    <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
    <div class="flex min-h-full flex-col items-start bg-base-200 is-drawer-close:w-64 is-drawer-open:w-14">
      <!-- Sidebar content here -->
      <ul class="menu w-full grow">
        <Layouts.menu
          navigate={~p"/categories"}
          icon_name="hero-document-plus"
          current_path={@current_path}
          current_params={@current_params}
          data_tip={gettext("Service Request")}
        >
          {gettext("Service Request")}
        </Layouts.menu>
        
        <Layouts.menu
          navigate={~p"/requests"}
          icon_name="hero-list-bullet"
          current_path={@current_path}
          current_params={@current_params}
          data_tip={gettext("My Request List")}
        >
          {gettext("My Request List")}
        </Layouts.menu>
        
        <Layouts.menu
          navigate={~p"/approvals"}
          icon_name="hero-check-badge"
          current_path={@current_path}
          current_params={@current_params}
          data_tip={gettext("Approval List")}
        >
          {gettext("Approval List")}
        </Layouts.menu>
         <li />
        <Layouts.menu
          navigate={~p"/delegations"}
          icon_name="hero-user-group"
          current_path={@current_path}
          current_params={@current_params}
          data_tip={gettext("Delegation")}
        >
          {gettext("Delegation")}
        </Layouts.menu>
        
        <Layouts.menu
          navigate={~p"/crews?menu_id=crews"}
          icon_name="hero-users"
          menu_id="crews"
          current_path={@current_path}
          current_params={@current_params}
          data_tip={gettext("My Crews")}
        >
          {gettext("My Crews")}
        </Layouts.menu>
        
        <Layouts.menu
          navigate={~p"/crews/all?menu_id=all_crews"}
          icon_name="hero-rectangle-stack"
          menu_id="all_crews"
          current_path={@current_path}
          current_params={@current_params}
          data_tip={gettext("All Crews")}
        >
          {gettext("All Crews")}
        </Layouts.menu>
        
        <Layouts.menu
          navigate={~p"/assets"}
          icon_name="hero-computer-desktop"
          current_path={@current_path}
          current_params={@current_params}
          data_tip={gettext("Assets")}
        >
          {gettext("Assets")}
        </Layouts.menu>
        
        <Layouts.menu
          navigate={~p"/boards?menu_id=boards"}
          icon_name="hero-list-bullet"
          menu_id="boards"
          current_path={@current_path}
          current_params={@current_params}
          data_tip={gettext("Boards")}
        >
          {gettext("Boards")}
        </Layouts.menu>
        
        <Layouts.menu
          navigate={~p"/api/graphiql"}
          icon_name="hero-document-text"
          menu_id="graphiql"
          current_path={@current_path}
          current_params={@current_params}
          data_tip={gettext("Api Doc")}
        >
          {gettext("Api Doc")}
        </Layouts.menu>
         <li />
        <Layouts.menu
          navigate={~p"/admin"}
          icon_name="hero-shield-check"
          current_path={@current_path}
          current_params={@current_params}
          data_tip={gettext("Admin Console")}
        >
          {gettext("Admin Console")}
        </Layouts.menu>
      </ul>
    </div>
  </div>
   <Layouts.flash_group flash={@flash} />
</div>
