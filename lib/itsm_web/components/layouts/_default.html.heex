<div class="drawer lg:drawer-open">
  <input id="my-drawer-4" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content">
    <!-- Navbar -->
    <nav class="navbar w-full bg-base-300">
      <label for="my-drawer-4" aria-label="open sidebar" class="btn btn-square btn-ghost">
        <!-- Sidebar toggle icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          stroke-linejoin="round"
          stroke-linecap="round"
          stroke-width="2"
          fill="none"
          stroke="currentColor"
          class="my-1.5 inline-block size-4"
        ><path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z">
        </path><path d="M9 4v16"></path><path d="M14 10l2 2l-2 2"></path></svg>
      </label>

      <div class="px-4">{@menu_title}</div>
    </nav>
    <!-- Page content here -->
    <div class="p-4">{render_slot(@inner_block)}</div>
  </div>

  <div class="drawer-side is-drawer-open:overflow-visible">
    <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
    <div class="flex min-h-full flex-col items-start bg-base-200 is-drawer-close:w-64 is-drawer-open:w-14">
      <!-- Sidebar content here -->
      <ul class="menu w-full grow">
        <Layouts.menu
          name={gettext("Service Request")}
          navigate={~p"/categories"}
          icon_name="hero-document-plus"
          selected={@menu_title}
        />

        <Layouts.menu
          name={gettext("My Request List")}
          navigate={~p"/requests"}
          icon_name="hero-list-bullet"
          selected={@menu_title}
        />

        <Layouts.menu
          name={gettext("Approval List")}
          navigate={~p"/approvals"}
          icon_name="hero-check-badge"
          selected={@menu_title}
        />
         <li />
        <Layouts.menu
          name={gettext("Delegations")}
          navigate={~p"/delegations"}
          icon_name="hero-user-group"
          selected={@menu_title}
        />

        <Layouts.menu
          name={gettext("My Crews")}
          navigate={~p"/crews"}
          icon_name="hero-users"
          selected={@menu_title}
       />

        <Layouts.menu
          name={gettext("All Crews")}
          navigate={~p"/crews/all"}
          icon_name="hero-rectangle-stack"
          selected={@menu_title}
        />

        <Layouts.menu
          name={gettext("Assets")}
          navigate={~p"/assets"}
          icon_name="hero-computer-desktop"
          selected={@menu_title}
        />

        <Layouts.menu
          name={gettext("Boards")}
          navigate={~p"/boards"}
          icon_name="hero-list-bullet"
          selected={@menu_title}
        />

        <Layouts.menu
          name={gettext("Api Doc")}
          navigate={~p"/api/graphiql"}
          icon_name="hero-document-text"
          selected={@menu_title}
        />
         <li />
        <Layouts.menu
          :if={@current_scope.role == "admin"}
          name={gettext("Admin Console")}
          navigate={~p"/admin"}
          icon_name="hero-shield-check"
          selected={@menu_title}
        />
      </ul>
    </div>
  </div>
   <Layouts.flash_group flash={@flash} />
</div>
