<div class="flex min-h-screen">
  <aside class="fixed inset-y-0 left-0 w-64 bg-[#2D3136] text-white shadow-xl z-50">
    <div class="flex flex-col h-full">
      <div class="h-20 flex items-center justify-center border-b border-gray-700 bg-white px-6">
        <a href="/" class="flex items-center">
          <img src={~p"/images/itsm_banner.svg"} alt="KB ITSM" class="h-10 w-auto" />
        </a>
      </div>

      <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto no-scrollbar">
        <.sidebar_menu_link
          navigate={~p"/categories"}
          icon_name="hero-document-plus"
          current_path={assigns[:current_path]}
        >
          {gettext("Service Request")}
        </.sidebar_menu_link>
        <.sidebar_menu_link
          navigate={~p"/requests"}
          icon_name="hero-list-bullet"
          current_path={assigns[:current_path]}
        >
          {gettext("My Request List")}
        </.sidebar_menu_link>
        <.sidebar_menu_link
          navigate={~p"/approvals"}
          icon_name="hero-check-badge"
          current_path={assigns[:current_path]}
        >
          {gettext("Approval List")}
        </.sidebar_menu_link>
        <div class="my-6 border-t border-gray-700/50"></div>

        <.sidebar_menu_link
          navigate={~p"/delegations"}
          icon_name="hero-user-group"
          current_path={assigns[:current_path]}
        >
          {gettext("Delegation")}
        </.sidebar_menu_link>
        <.sidebar_menu_link
          navigate={~p"/crews?menu_id=crews"}
          icon_name="hero-users"
          menu_id="crews"
          current_path={assigns[:current_path]}
        >
          {gettext("My Crews")}
        </.sidebar_menu_link>
        <.sidebar_menu_link
          navigate={~p"/crews/all?menu_id=all_crews"}
          icon_name="hero-rectangle-stack"
          menu_id="all_crews"
          current_path={assigns[:current_path]}
        >
          {gettext("All Crews")}
        </.sidebar_menu_link>
        <.sidebar_menu_link
          navigate={~p"/assets"}
          icon_name="hero-computer-desktop"
          current_path={assigns[:current_path]}
        >
          {gettext("Assets")}
        </.sidebar_menu_link>
        <.sidebar_menu_link
          navigate={~p"/boards?menu_id=boards"}
          icon_name="hero-list-bullet"
          menu_id="boards"
          current_path={assigns[:current_path]}
        >
          {gettext("Boards")}
        </.sidebar_menu_link>

        <.sidebar_menu_link
          navigate={~p"/api/graphiql"}
          icon_name="hero-"
          menu_id="graphiql"
          current_path={assigns[:current_path]}
        >
          {gettext("Graphiql")}
        </.sidebar_menu_link>
        <div :if={@current_user && @current_user.role == "admin"} class="mt-8">
          <p class="px-4 text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">
            ADMIN SYSTEM
          </p>

          <.sidebar_menu_link
            navigate={~p"/admin"}
            icon_name="hero-shield-check"
            current_path={assigns[:current_path]}
          >
            {gettext("Admin Console")}
          </.sidebar_menu_link>
        </div>
      </nav>

      <div class="p-4 bg-[#24272b] border-t border-gray-700">
        <div class="flex items-center justify-between px-2 mb-4 bg-gray-800/50 rounded-full py-1.5 border border-gray-700">
          <% is_ko = Gettext.get_locale(ItsmWeb.Gettext) == "ko" %>
          <span class={"text-[10px] font-black px-2 #{if is_ko, do: "text-kb-yellow", else: "text-gray-500"}"}>
            KO
          </span>
          <.link
            navigate={"?locale=#{if is_ko, do: "en", else: "ko"}"}
            class="relative inline-flex h-5 w-10 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-gray-600 transition-colors duration-200"
          >
            <span class={"pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-sm transition duration-200 #{if is_ko, do: "translate-x-0", else: "translate-x-5"}"}>
            </span>
          </.link>
          <span class={"text-[10px] font-black px-2 #{if is_ko, do: "text-gray-500", else: "text-kb-yellow"}"}>
            EN
          </span>
        </div>

        <div :if={@current_user} class="flex items-center justify-between px-2 pt-2">
          <div class="flex flex-col min-w-0">
            <span class="text-[10px] text-gray-500 font-bold uppercase">Authorized User</span>
            <span class="text-xs font-bold text-gray-200 truncate w-28">
              {@current_user.email}
            </span>
          </div>

          <div class="flex gap-1">
            <.link
              href={~p"/users/settings"}
              class="p-1.5 text-gray-500 hover:text-kb-yellow transition-colors"
            >
              <.icon name="hero-cog-6-tooth-solid" class="w-4 h-4" />
            </.link>
            <.link
              href={~p"/users/log_out"}
              method="delete"
              class="p-1.5 text-gray-500 hover:text-red-500 transition-colors"
            >
              <.icon name="hero-arrow-right-on-rectangle-solid" class="w-4 h-4" />
            </.link>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <main class="flex-1 p-8">
    <div class="max-w-6xl mx-auto"><.flash_group flash={@flash} /> {@inner_content}</div>
  </main>
</div>
