<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/"><img src={~p"/images/logo.svg"} width="36" /></a>
      <p class="bg-brand/5 text-brand rounded-full px-2 font-medium leading-6">
        v{Application.spec(:phoenix, :vsn)}
      </p>
    </div>
    
    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <.link navigate={~p"/categories"}>
        <%!-- Service Request --%> {gettext("Service Request")}
      </.link> <.link navigate={~p"/admin/categories"}><%!-- Admin --%> {gettext("Admin")}</.link>
      <.link navigate={~p"/requests"}>{gettext("Request List")}</.link>
      <.link navigate={~p"/approvals"}>{gettext("Approval List")}</.link>
      <.link navigate={~p"/delegations"}>{gettext("Delegation")}</.link>
      <.link navigate={~p"/crews"} data-replace="true">{gettext("My Crews")}</.link>
      <.link navigate={~p"/crews/all"} data-replace="true">{gettext("All Crews")}</.link>
      <%!-- <.link
        href="?locale=en"
        method="get"
        class={["mr-2 text-sm", Gettext.get_locale(ItsmWeb.Gettext) == "en" && "font-bold"]}
      >
        English
      </.link>
      <.link
        href="?locale=ko"
        method="get"
        class={["text-sm", Gettext.get_locale(ItsmWeb.Gettext) == "ko" && "font-bold"]}
      >
        한국어
      </.link> --%>
    </div>
  </div>
</header>

<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-4xl"><.flash_group flash={@flash} /> {@inner_content}</div>
</main>
